# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/prepmatch?retryWrites=true&w=majority

# Secret key used for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API Key
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Server Port (Render sets this dynamically)
PORT=3000

# Environment mode
NODE_ENV=production
